# Santosh Group of Institutions (SGI) - Environment Configuration

# MongoDB Connection String (Optional: if omitted, the system seamlessly runs on local data/content/*.json files)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/santosh_group?retryWrites=true&w=majority
MONGODB_DB=santosh_group

# Admin CMS Password for /admin/login
ADMIN_PASSWORD=santosh1977

# Cloudinary Configuration for Direct CMS Image Uploads
# For Signed Uploads:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Alternatively, for Unsigned Uploads:
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
